{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundboard",
  "version": "1.0.0",
  "identifier": "com.sebastien.soundboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Soundboard",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://*.giphy.com; media-src https://www.myinstants.com https://cdn.freesound.org",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/images/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "publisher": "Sébastien (Seboulo)",
    "copyright": "© 2026 Sébastien",
    "category": "Utility",
    "shortDescription": "Soundboard pour Discord",
    "longDescription": "Joue des sons dans ton micro Discord via VB-Audio Virtual Cable, avec raccourcis globaux et contrôle depuis le téléphone.",
    "homepage": "https://github.com/Seboulo/soundboard",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMUJBQzgxOTVGRDA3MTIKUldRU0IvMlZnYXdiYlh1bHJsNnJMNk5LK0ExSVZzUVQ3aXhCSDZ2MjFiNWVWSk0zN1NTT2xCMy8K",
      "endpoints": [
        "https://github.com/Seboulo/soundboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
